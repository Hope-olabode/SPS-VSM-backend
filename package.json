{
  "name": "sps-vms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js up",
    "migrate:status": "node --env-file=.env scripts/migrate.js status",
    "migrate:rollback": "node --env-file=.env scripts/migrate.js rollback",
    "migrate:make": "node scripts/migrate.js make",
    "seed": "node --env-file=.env seed.js",
    "jobs": "node --env-file=.env scripts/run-jobs.js",
    "db:check": "node --env-file=.env scripts/check-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "zod": "^4.0.0"
  }
}
